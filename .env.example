# Copy to .env and adjust. Nothing loads this file automatically: the Go server
# reads the process environment, and the Makefile forwards values to the Astro
# build. Source it first.
#
#   set -a && . ./.env && set +a
#   make run
#
# The Makefile uses ?= throughout, so anything exported here wins over its
# defaults. Astro/Vite would also read web/.env on its own, but the Makefile
# already passes SITE_URL and PUBLIC_ORIGIN_URL through to `pnpm build`, so
# keeping one file here beats maintaining two.

# ---------------------------------------------------------------------------
# Build time. Baked into the binary; changing these means rebuilding.
# ---------------------------------------------------------------------------

# Canonical origin. Ends up in canonical <link> tags and the sitemap, so a wrong
# value ships wrong URLs and is not fixable at runtime.
SITE_URL=http://localhost:8080

# Grey-clouded origin hostname. Enables the edge-versus-origin control on /perf.
# Empty is correct locally: there is no edge in front of a local server, and the
# control hides itself rather than showing half a comparison.
PUBLIC_ORIGIN_URL=

# ---------------------------------------------------------------------------
# Runtime. Read by the Go server at startup.
# ---------------------------------------------------------------------------

# 8080 collides with other services on a shared box; override freely.
PORT=8080

# Field-data checkpoint. The container default is /data/rum.json on a mounted
# volume. That path does not exist locally -- the server still starts, because a
# missing file is treated as an empty store, but the checkpoint on SIGTERM fails
# and the histograms are lost on restart. Point it somewhere writable to test
# the RUM path across restarts.
RUM_DATA=./rum.json

# The site's own origin, for CORS and Timing-Allow-Origin on the /api/ping
# probe. Needed only when PUBLIC_ORIGIN_URL is set, since that is what makes the
# probe cross-origin; without Timing-Allow-Origin the browser reports zeroes for
# every Resource Timing phase and the comparison measures nothing.
SITE_ORIGIN=

# Where host CPU, memory, load and uptime are read from. Docker does not
# namespace /proc, so the default reports the host's real figures even inside
# the container.
METRICS_PROC=/proc

# Disk is off by default. statfs inside a container measures the overlay
# filesystem, which tells nobody anything, and reporting host disk means
# bind-mounting a host path into an internet-facing container. If you enable it,
# mount the narrowest useful path read-only rather than /.
METRICS_DISK_PATH=

# ---------------------------------------------------------------------------
# Deployment. Set these in Dokploy's environment, not in this file.
# ---------------------------------------------------------------------------
#   DOMAIN   bare hostname for the Traefik host rules, e.g. example.com
#   IMAGE    ghcr.io/pawan67/portfolio-2027
#   TAG      latest; CI overrides it per deploy with the commit SHA

# ---------------------------------------------------------------------------
# CI. Set as GitHub Actions variables and secrets, not in this file.
# ---------------------------------------------------------------------------
#   variable  SITE_URL             https://example.com
#   variable  PUBLIC_ORIGIN_URL    https://origin.example.com
#   secret    DOKPLOY_WEBHOOK_URL
#   secret    CLOUDFLARE_ZONE_ID
#   secret    CLOUDFLARE_API_TOKEN  scoped to Zone -> Cache Purge only
