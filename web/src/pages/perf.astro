---
import BaseLayout from '../layouts/BaseLayout.astro';

const budgets = [
  { name: 'HTML, brotli', limit: '14 KB', why: 'fits the initial congestion window — one round trip' },
  { name: 'CSS per page, brotli', limit: '6 KB', why: 'inlined, so it is paid on every document' },
  { name: 'Render-blocking JS', limit: '0 bytes', why: 'the only script is deferred and measures this page' },
  { name: 'Deferred JS', limit: '4 KB brotli', why: 'field measurement is not free, but it is bounded' },
  { name: 'Fonts', limit: '21 KB', why: 'one display face, metric-matched fallback, CLS 0' },
];

const hasOriginComparison = Boolean(import.meta.env.PUBLIC_ORIGIN_URL);
---

<BaseLayout
  title="Perf"
  description="Field measurements from real visitors to this site, published as they arrive."
>
  <section class="pt-10">
    <h1 class="text-[length:var(--text-title)]">Measurements</h1>

    <p class="mt-4 max-w-[var(--measure)] text-[length:var(--text-lead)] text-[var(--color-muted)]">
      Every site claims to be fast. This page is here so the claim can be
      checked.
    </p>

    <!-- Field data -------------------------------------------------------- -->
    <div class="mt-14" data-field-data>
      <h2 class="font-mono text-xs font-normal tracking-[0.14em] text-[var(--color-muted)] uppercase">
        Field data
      </h2>

      <p class="mt-3 max-w-[var(--measure)] text-sm text-[var(--color-muted)]" data-field-summary>
        Loading measurements…
      </p>

      <div class="mt-6" data-metrics></div>

      <h3 class="mt-12 font-mono text-xs font-normal tracking-[0.14em] text-[var(--color-muted)] uppercase">
        Largest Contentful Paint by region
      </h3>
      <div class="mt-4" data-countries></div>

      <p class="mt-8 max-w-[var(--measure)] text-sm text-[var(--color-muted)]">
        Collected first-party from real visits. No cookies, no identifiers, no
        third party — the browser posts five numbers to this site's own origin,
        which folds them into a histogram and discards the rest. Country comes
        from Cloudflare's edge header; no IP address is stored.
      </p>
    </div>

    <!-- Edge versus origin ------------------------------------------------ -->
    <div class="mt-16">
      <h2 class="font-mono text-xs font-normal tracking-[0.14em] text-[var(--color-muted)] uppercase">
        Edge versus origin
      </h2>

      <p class="mt-3 max-w-[var(--measure)] text-sm text-[var(--color-muted)]">
        A CDN makes any site look fast, which makes most published numbers
        ambiguous. This measures the same endpoint twice — once through
        Cloudflare, once against the VPS directly — from your browser, right now.
        {!hasOriginComparison && (
          <span class="text-[var(--color-accent)]">
            {' '}The bare-origin hostname is not configured yet, so only the edge
            timing will appear.
          </span>
        )}
      </p>

      <button
        type="button"
        data-measure
        class="mt-5 cursor-pointer rounded border border-[var(--color-line)] bg-transparent px-4 py-2 font-mono text-sm text-[var(--color-text)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] disabled:cursor-wait disabled:opacity-60"
      >
        Measure now
      </button>

      <div class="mt-5" data-measure-output></div>

      <noscript>
        <p class="mt-4 text-sm text-[var(--color-muted)]">
          This measurement needs JavaScript, which is the honest trade: you
          cannot time a network request without running code.
        </p>
      </noscript>
    </div>

    <!-- Budgets ----------------------------------------------------------- -->
    <div class="mt-16">
      <h2 class="font-mono text-xs font-normal tracking-[0.14em] text-[var(--color-muted)] uppercase">
        Budgets
      </h2>

      <p class="mt-3 max-w-[var(--measure)] text-sm text-[var(--color-muted)]">
        Enforced in CI. A build that exceeds one of these fails and never reaches
        the server.
      </p>

      <dl class="mt-6 list-none p-0">
        {budgets.map(({ name, limit, why }) => (
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-t border-[var(--color-line)] py-4">
            <dt class="font-mono text-sm">{name}</dt>
            <dd class="m-0 font-mono text-sm text-[var(--color-accent)]">{limit}</dd>
            <p class="m-0 w-full text-sm text-[var(--color-muted)]">{why}</p>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/perf.ts';
</script>
