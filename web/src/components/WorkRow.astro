---
interface Props {
  href: string;
  title: string;
  summary: string;
  year: number;
  stack: string[];
}

const { href, title, summary, year, stack } = Astro.props;
---

<li class="border-t border-[var(--color-line)]">
  <a href={href} class="group block py-6 no-underline">
    <div class="flex items-baseline justify-between gap-4">
      <h3 class="font-display text-2xl normal-case tracking-tight text-[var(--color-text)] group-hover:text-[var(--color-accent)]">
        {title}
      </h3>
      <span class="shrink-0 font-mono text-xs text-[var(--color-muted)]">{year}</span>
    </div>

    <p class="mt-1 max-w-[var(--measure)] text-[var(--color-muted)]">{summary}</p>

    <p class="mt-3 font-mono text-xs text-[var(--color-muted)]">
      {stack.join(' · ')}
    </p>
  </a>
</li>
