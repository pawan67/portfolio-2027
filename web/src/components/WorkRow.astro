---
interface Props {
  href: string;
  title: string;
  summary: string;
  year: number;
  stack: string[];
  /* /work/ lists rows directly under its h1; the home page nests them under a
     "Selected work" h2. The row has to be told which, or one of the two pages
     skips a level. */
  level?: 2 | 3;
}

const { href, title, summary, year, stack, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<li class="work-row">
  <a href={href} class="group block">
    <div class="flex items-baseline justify-between gap-4">
      <Heading class="font-display text-2xl normal-case tracking-tight">
        {title}<span class="work-arrow" aria-hidden="true">→</span>
      </Heading>
      <span class="shrink-0 font-mono text-xs text-[var(--color-muted)]">{year}</span>
    </div>

    <p class="mt-1 max-w-[var(--measure)] text-[var(--color-muted)]">{summary}</p>

    <p class="mt-3 font-mono text-xs text-[var(--color-muted)]">
      {stack.join(' · ')}
    </p>
  </a>
</li>
