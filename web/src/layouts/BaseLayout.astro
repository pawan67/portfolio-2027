---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { person } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle =
  Astro.url.pathname === '/' ? title : `${title} — ${person.short}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* The two render-critical subresources. Every route puts an h1 and body
        copy above the fold, so both faces are discovered late without this and
        both cost a visible swap. The serif is listed first: it sets the h1,
        which is the LCP element on every page, so it must not wait.
        Stable filenames so they can be preloaded without knowing a build hash;
        versioned so they stay immutably cacheable. */}
    <link
      rel="preload"
      href="/fonts/instrument-serif-v1.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/geist-sans-v1.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Kept in step with --color-bg by hand; it is the one colour the CSS
        cannot reach, because the browser paints the chrome before it parses. */}
    <meta name="theme-color" content="#131211" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={person.short} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />

    {/* Cut from design/brand/final by `build.py --ship`. The tab icon is the
        stacked square cut, not the horizontal P67 lockup: a 16px slot gives the
        lockup 64% of its height in a box it does not fit, and it goes to mush.
        The .ico is listed first but only legacy browsers take it -- everything
        current prefers the SVG and stops there. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Declarative prerender-on-hover. Parsed, never executed: 0KB of JS.
        Safe because every route is a static document with no side effects.

        Written as literal JSON with is:inline. Astro does not evaluate {}
        expressions inside <script>, so building this string in the frontmatter
        and interpolating it emits the source text verbatim and the rules
        silently fail to parse. */}
    <script type="speculationrules" is:inline>
      {"prerender":[{"where":{"href_matches":"/*"},"eagerness":"moderate"}]}
    </script>
    {/* Deferred module script: measured, never render-blocking. It is what
        makes /perf possible -- the site cannot publish field data it does not
        collect. */}
    <script>
      import '../scripts/vitals.ts';
      // Bundled with the beacon rather than emitted as its own module: one
      // request, and two small files share a compression context.
      import '../scripts/listening.ts';
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:m-3 focus:rounded focus:bg-[var(--color-surface)] focus:px-3 focus:py-2"
    >
      Skip to content
    </a>

    <SiteHeader />

    <main id="main" class="mx-auto w-full max-w-3xl grow px-6">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
