node_modules/
.astro/
/bin/
/web/dist/
# Populated by the build. The directory must exist in a fresh clone or
# //go:embed all:dist fails to compile, so .gitkeep is tracked.
server/dist/*
!server/dist/.gitkeep
.env
.env.*
!.env.example
.DS_Store

# Local RUM checkpoint. RUM_DATA points here in .env for local runs; the
# container writes to /data/rum.json on a volume. Runtime state, not source.
rum.json

# Brand exploration pages and the per-round SVG sets are regenerated by
# design/brand/build.py; only the generator and the shipped assets in
# design/brand/final are tracked.
design/brand/*.html
design/brand/svg/
design/brand/banners/
design/brand/block-family/
design/brand/p67-family/
